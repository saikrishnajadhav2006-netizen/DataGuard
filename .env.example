# DataGuard AI Configuration

# Database Configuration (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_AUTH_ENABLED=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_for_hs256

# AI Configuration (Spring AI)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini

# Frontend Supabase Auth (use the anon key, never the service-role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Repository review limits
DATAGUARD_REVIEW_MAX_UNCOMPRESSED_BYTES=104857600
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=25MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=25MB
