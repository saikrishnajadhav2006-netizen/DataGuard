SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your-google-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Backend authentication
JWT_SECRET=
JWT_EXPIRATION_MS=1800000

# Aiven PostgreSQL. Use the TLS-enabled connection URL from the Aiven console,
# including sslmode=require (or Aiven's supplied CA certificate settings).
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=10

# AI Radar — Groq (OpenAI-compatible chat completions)
GROQ_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# Fixed project ZIP storage and limits
DATAGUARD_ARCHIVE_STORAGE_DIR=
DATAGUARD_MAX_OUTPUT_BYTES=104857600
DATAGUARD_MAX_UPLOAD_BYTES=26214400
DATAGUARD_MAX_UNCOMPRESSED_BYTES=104857600
DATAGUARD_MAX_FILES=200
DATAGUARD_MAX_SINGLE_FILE_BYTES=1048576

# GitHub App configuration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
