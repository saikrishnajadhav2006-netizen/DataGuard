# Copy to .env in repository root. Never commit .env or real secrets.
# Aiven Console -> PostgreSQL service -> Connection information
DB_URL=jdbc:postgresql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=REPLACE_WITH_AIVEN_PASSWORD
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Private random value, at least 32 UTF-8 bytes.
JWT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# Optional Groq API integration; keep the key on the backend only.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback provider. Add your own key locally; never commit a real key.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATAGUARD_REVIEW_MAX_UNCOMPRESSED_BYTES=104857600

