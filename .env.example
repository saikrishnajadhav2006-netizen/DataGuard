# DataGuard AI configuration. Copy to .env and replace placeholders locally.
# Database: local H2 defaults work without these values; use Aiven PostgreSQL for persistent data.
DB_URL=jdbc:postgresql://<AIVEN_HOST>:<AIVEN_PORT>/defaultdb?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=replace-with-your-aiven-password
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect


# Generate a private random secret of at least 32 bytes for local JWT auth.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq AI (only provider supported by the backend)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Repository review limits
DATAGUARD_REVIEW_MAX_UNCOMPRESSED_BYTES=104857600

# Frontend auth defaults to Spring Boot JWT. Set this only for an intentional Supabase Auth deployment.
# VITE_AUTH_PROVIDER=supabase
