# DataGuard AI configuration. Copy to .env and replace placeholders locally.
# Database: local H2 defaults work without these values; use Supabase for persistent data.
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-supabase-password
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Supabase Auth (set true only when Supabase Auth is configured)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_AUTH_ENABLED=false

# Generate a private random secret of at least 32 bytes for local JWT auth.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Groq AI (only provider supported by the backend)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Supabase Auth (use the anon key, never the service-role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Repository review limits
DATAGUARD_REVIEW_MAX_UNCOMPRESSED_BYTES=104857600
