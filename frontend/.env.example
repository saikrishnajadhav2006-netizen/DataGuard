# Frontend API/auth configuration
VITE_API_URL=http://localhost:8080
# Use Spring Boot JWT auth by default. Set to "supabase" only when backend Supabase JWT validation is also configured.
VITE_AUTH_PROVIDER=spring
# Required only when VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
